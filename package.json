{
  "name": "swiss-design-ui",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run build:library && npm run build:types && npm run build:docs",
    "prepack": "npm run build:library && npm run build:types",
    "build:library": "vite build --config vite.config.lib.js",
    "build:types": "tsc -p tsconfig.lib.json",
    "build:docs": "vite build --outDir docs-dist",
    "lint": "oxlint",
    "preview": "vite preview --outDir docs-dist"
  },
  "dependencies": {
    "lucide-react": "^1.62.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
